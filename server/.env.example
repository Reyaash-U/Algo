NODE_ENV=development
PORT=5000

# PostgreSQL connection string.
# Local:  postgresql://USER:PASSWORD@localhost:5432/algovault
# Hosted (e.g. Supabase/Neon/Render Postgres): use the connection string they give you.
DATABASE_URL=postgresql://postgres.vgrphekskhkbtlzglkgg:QZel8rpuxhtjEM1k@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
ACCESS_TTL=15m
REFRESH_TTL=7d

# Frontend origin(s) for CORS whitelist — comma-separated for multiple
# (e.g. your local dev origin + a friend's, or local + deployed frontend)
CLIENT_ORIGIN=http://localhost:5173

# Stub mode: true = unimplemented endpoints return mock data (keep ON early)
ENABLE_STUBS=true

# Email (Nodemailer) — leave blank until wiring digests
SMTP_HOST=
SMTP_USER=
SMTP_PASS=